/target
.DS_Store
divus-factus-*.png

# The music generator's leavings: Python bytecode, and whatever loop was
# last rendered to listen to. The script is worth keeping; these are not.
__pycache__/
*.pyc
/scratch_test.wav
/logs

# THE KEY IS NEVER IN THIS REPOSITORY. The living voice reads
# `OPENAI_API_KEY` from the environment and from nowhere else, but the sister
# fork kept its key in a file beside the executable and a copied habit is how
# these things get committed. Belt and braces.
OpenAI-API-Key.txt
# Whatever the file is called. Brett keeps one at OENAI_API_KEY.txt - the
# typo is exactly why this globs rather than naming it, and why the launcher
# below finds it by pattern instead of by an exact name.
*API_KEY*.txt
*API-KEY*.txt
*.api-key
.env
